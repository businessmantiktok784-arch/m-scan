{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mining-scanner.local/schemas/camera-calibration.schema.json",
  "title": "Camera calibration record (v2)",
  "description": "Contract for operation `camera_calibration` (registry v1.6, Stage 3.3, IMPLEMENTED for known-target checkerboard estimation on device with a pure-TypeScript Zhang solver; OpenCV is NOT available in this environment and the record's engine block says so). v2 is backward compatible with v1: every v1 field keeps its meaning, and v2 adds engine identity, measured metrics, target configuration, per-frame evaluations, provenance blocks and the computed/passed/not-validated status pair. Honesty rules: factory/default intrinsics must be recorded with source `factory_assumed` and a factory_provenance block — never presented as measured; `computed` never means `validated`; a calibration fixes pixel geometry only and never establishes scene scale (scale_status stays UNKNOWN, basis `none`).",
  "type": "object",
  "required": [
    "calibration_id", "project_id", "session_id", "camera_label", "image_width", "image_height",
    "fx", "fy", "cx", "cy", "model", "distortion", "source", "calibration_method", "created_at",
    "engine", "metrics", "target_config", "source_frame_ids", "source_video_asset_ids",
    "frame_evaluations", "factory_provenance", "import_provenance", "calibration_status",
    "validation_status", "scale_status", "scale_provenance", "coordinate_convention", "operation_id",
    "warnings", "errors"
  ],
  "properties": {
    "calibration_id": { "type": "string", "pattern": "^CAL-[0-9a-f]{8}$" },
    "project_id": { "type": "string", "pattern": "^MS-[0-9a-f]{8}$" },
    "session_id": { "oneOf": [{ "type": "string", "pattern": "^SES-[0-9a-f]{8}$" }, { "type": "null" }] },
    "camera_label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "image_width": { "type": "integer", "exclusiveMinimum": 0 },
    "image_height": { "type": "integer", "exclusiveMinimum": 0 },
    "fx": { "type": "number", "exclusiveMinimum": 0, "description": "Focal length in PIXELS (full-resolution frame)." },
    "fy": { "type": "number", "exclusiveMinimum": 0, "description": "Focal length in PIXELS (full-resolution frame)." },
    "cx": { "type": "number", "minimum": 0, "description": "Principal point x in pixels." },
    "cy": { "type": "number", "minimum": 0, "description": "Principal point y in pixels." },
    "model": {
      "enum": ["opencv_radial_tangential_k1_k2_p1_p2_k3", "none", "unspecified"],
      "description": "Distortion model. The solver estimates opencv_radial_tangential_k1_k2_p1_p2_k3 (order [k1, k2, p1, p2, k3] on normalized coordinates)."
    },
    "distortion": { "type": "array", "items": { "type": "number" }, "maxItems": 8 },
    "source": {
      "enum": ["estimated_from_capture", "factory_assumed", "operator_provided"],
      "description": "The referee against invented values: only estimated_from_capture may claim measured intrinsics."
    },
    "calibration_method": {
      "enum": ["known_target_checkerboard", "factory_assumed", "imported"],
      "description": "Method, kept distinguishable end-to-end."
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "engine": {
      "type": "object",
      "required": ["tool", "tool_version", "note"],
      "properties": {
        "tool": { "type": "string", "minLength": 1, "maxLength": 120 },
        "tool_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "note": { "type": "string", "minLength": 1, "maxLength": 500, "description": "States what the engine replaces on device (OpenCV is NOT available) and any validation caveat." }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["input_frames", "frames_accepted", "frames_rejected", "frames_with_warnings", "detected_points", "reprojection_error_px", "per_image_error_px", "coverage_note", "converged"],
      "properties": {
        "input_frames": { "type": "integer", "minimum": 0 },
        "frames_accepted": { "type": "integer", "minimum": 0 },
        "frames_rejected": { "type": "integer", "minimum": 0 },
        "frames_with_warnings": { "type": "integer", "minimum": 0 },
        "detected_points": { "type": "integer", "minimum": 0 },
        "reprojection_error_px": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }], "description": "RMS reprojection error in pixels, measured from the actual corners; null when not computed." },
        "per_image_error_px": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "coverage_note": { "type": "string", "maxLength": 500 },
        "converged": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "target_config": {
      "oneOf": [{ "$ref": "#/$defs/checkerboard-target" }, { "type": "null" }]
    },
    "source_frame_ids": {
      "type": "array", "items": { "type": "string", "pattern": "^FRM-[0-9a-f]{8}$" }, "maxItems": 10000,
      "description": "Only frames actually USED by the estimation (accepted frames)."
    },
    "source_video_asset_ids": { "type": "array", "items": { "type": "string" }, "maxItems": 1000 },
    "frame_evaluations": {
      "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/frame-evaluation" },
      "description": "EVERY supplied frame with its suitability verdict and machine-readable reasons."
    },
    "factory_provenance": { "oneOf": [{ "$ref": "#/$defs/factory-provenance" }, { "type": "null" }] },
    "import_provenance": { "oneOf": [{ "$ref": "#/$defs/import-provenance" }, { "type": "null" }] },
    "calibration_status": { "enum": ["computed", "computed_with_warnings", "failed"] },
    "validation_status": {
      "enum": ["passed_configured_checks", "did_not_pass_configured_checks", "not_evaluated", "independently_validated"],
      "description": "`independently_validated` requires targeted independent evidence this app cannot invent; the shipped pipeline never emits it yet."
    },
    "scale_status": { "const": "UNKNOWN", "description": "Calibration is pixel geometry; never a scene-scale claim." },
    "scale_provenance": {
      "type": "object",
      "required": ["basis", "detail"],
      "properties": {
        "basis": { "const": "none" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "coordinate_convention": { "type": "string", "minLength": 1, "maxLength": 200 },
    "operation_id": { "type": "string", "pattern": "^CAL-[0-9a-f]{8}$" },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 100 },
    "errors": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 100 }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": { "type": "string", "description": "ISO 8601, UTC or explicit offset." },
    "checkerboard-target": {
      "type": "object",
      "required": ["type", "corner_columns", "corner_rows", "square_size", "unit", "identification"],
      "properties": {
        "type": { "const": "checkerboard" },
        "corner_columns": { "type": "integer", "minimum": 2, "maximum": 30, "description": "Inner corners per column (square count minus one)." },
        "corner_rows": { "type": "integer", "minimum": 2, "maximum": 30, "description": "Inner corners per row (square count minus one)." },
        "square_size": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 16, "description": "The operator's declared measurement unit; the app never converts or assumes one." },
        "identification": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "frame-evaluation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame_id", "file_path", "suitability", "reasons", "detected_corners"],
        "properties": {
          "frame_id": { "type": "string", "pattern": "^FRM-[0-9a-f]{8}$" },
          "file_path": { "type": "string", "minLength": 1 },
          "suitability": { "enum": ["accepted", "accepted_with_warnings", "rejected", "not_evaluated"] },
          "reasons": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 }, "maxItems": 16 },
          "detected_corners": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
        },
        "additionalProperties": false
      }
    },
    "factory-provenance": {
      "type": "object",
      "required": ["parameter_source", "device_model", "camera_id", "source_documentation", "retrieved_at", "assumptions"],
      "properties": {
        "parameter_source": { "type": "string", "minLength": 1, "maxLength": 200 },
        "device_model": { "oneOf": [{ "type": "string", "maxLength": 120 }, { "type": "null" }] },
        "camera_id": { "oneOf": [{ "type": "string", "maxLength": 120 }, { "type": "null" }] },
        "source_documentation": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "retrieved_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "assumptions": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 16 }
      },
      "additionalProperties": false
    },
    "import-provenance": {
      "type": "object",
      "required": ["original_format", "original_filename", "source_documentation", "checksum_md5"],
      "properties": {
        "original_format": { "type": "string", "minLength": 1, "maxLength": 80 },
        "original_filename": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source_documentation": { "type": "string", "maxLength": 1000 },
        "checksum_md5": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
      },
      "additionalProperties": false
    }
  }
}
