{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mining-scanner.local/schemas/registration-operation.schema.json",
  "title": "Point-cloud registration operation record (v1.1)",
  "description": "Contract for operation `pointcloud_registration` (registry stage 3, NOT_IMPLEMENTED). v1.1 (Stage 3 planning correction): inputs are ≥2 genuine PC- assets (camera poses are NOT registration inputs — see visual_tracking/trajectory_generation); adds coordinate_frame, target_asset_id, scale_compatibility and processing-tool provenance. Records the transform, residuals and the metric scale applied — with provenance.",
  "type": "object",
  "required": ["operation_id", "project_id", "method", "input_asset_ids", "coordinate_frame", "status", "started_at", "finished_at"],
  "properties": {
    "operation_id": { "type": "string", "pattern": "^OP-[0-9a-f]{8}$" },
    "project_id": { "type": "string", "pattern": "^MS-[0-9a-f]{8}$" },
    "method": { "enum": ["icp_point_to_point", "icp_point_to_plane", "multiway", "other"], "description": "The removed v1 value 'trajectory_fusion' was a category error: camera-pose-based combination of frames is pointcloud_reconstruction, not registration." },
    "method_detail": { "type": "string", "maxLength": 200 },
    "input_asset_ids": { "type": "array", "items": { "type": "string", "pattern": "^PC-[0-9a-f]{8}$" }, "minItems": 2, "description": "Genuine point-cloud assets only." },
    "target_asset_id": { "oneOf": [{ "type": "string", "pattern": "^PC-[0-9a-f]{8}$" }, { "type": "null" }], "description": "The cloud the others were aligned onto, when applicable." },
    "output_asset_id": { "oneOf": [{ "type": "string", "pattern": "^PC-[0-9a-f]{8}$" }, { "type": "null" }] },
    "coordinate_frame": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Explicit frame of the aligned result, e.g. 'target_asset_frame'." },
    "transform_4x4": { "oneOf": [{ "type": "array", "items": { "type": "number" }, "minItems": 16, "maxItems": 16 }, { "type": "null" }], "description": "Row-major 4x4; null while queued/running/failed." },
    "residual": {
      "oneOf": [
        { "type": "object", "properties": { "rmse": { "type": "number", "minimum": 0, "description": "In reconstruction units." }, "correspondences": { "type": "integer", "minimum": 0 } }, "required": ["rmse", "correspondences"], "additionalProperties": false },
        { "type": "null" }
      ]
    },
    "scale_compatibility": { "oneOf": [{ "enum": ["compatible", "incompatible", "unassessed"] }, { "type": "null" }], "description": "Whether the inputs' scale claims were checked and are compatible. 'incompatible' must fail the operation." },
    "metric_scale": { "oneOf": [{ "$ref": "#/$defs/metric-scale" }, { "type": "null" }], "description": "Metric scale applied to the output. Omit entirely when no scale was applied." },
    "tool": { "type": "string", "maxLength": 120 },
    "tool_version": { "type": "string", "maxLength": 60 },
    "status": { "enum": ["queued", "running", "done", "failed"] },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "message": { "type": "string", "maxLength": 2000, "description": "Human-readable result or failure reason. Never fabricated measurements." }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": { "type": "string", "description": "ISO 8601, UTC or explicit offset." },
    "metric-scale": {
      "type": "object",
      "required": ["metres_per_unit", "provenance"],
      "properties": {
        "metres_per_unit": { "type": "number", "exclusiveMinimum": 0 },
        "provenance": { "$ref": "#/$defs/scale-provenance" }
      },
      "additionalProperties": false
    },
    "scale-provenance": {
      "type": "object",
      "required": ["scale_status", "basis", "created_at"],
      "properties": {
        "scale_status": { "enum": ["UNKNOWN", "RELATIVE", "ESTIMATED", "VALIDATED"] },
        "basis": { "enum": ["none", "known_dimension", "survey_control", "validated_depth", "external_metric_scan", "operator_assumed", "other_documented"] },
        "detail": { "type": "string", "maxLength": 2000 },
        "measured_by": { "type": "string", "maxLength": 120 },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false,
      "description": "Rules: UNKNOWN pairs with basis 'none'; operator_assumed stays ESTIMATED at best; VALIDATED requires independent metric evidence."
    }
  }
}
