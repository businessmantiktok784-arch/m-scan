{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mining-scanner.local/schemas/geometry-validation.schema.json",
  "title": "Geometry validation record (v1)",
  "description": "Contract for geometry checks over a PC- or MSH- asset (first produced by Stage 3+ operations). A validation verdict carries the asset's scale status and its provenance; units are only 'confirmed' after a real check.",
  "type": "object",
  "required": ["validation_id", "project_id", "asset_id", "checks", "units_confirmed", "scale_status", "created_at"],
  "properties": {
    "validation_id": { "type": "string", "pattern": "^VAL-[0-9a-f]{8}$" },
    "project_id": { "type": "string", "pattern": "^MS-[0-9a-f]{8}$" },
    "asset_id": { "type": "string", "pattern": "^(PC|MSH)-[0-9a-f]{8}$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "status": { "enum": ["pass", "warn", "fail", "not_run"] },
          "detail": { "type": "string", "maxLength": 500 }
        },
        "additionalProperties": false
      }
    },
    "watertight": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
    "degenerate_triangles": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "units_confirmed": { "type": "boolean", "description": "True only after the unit was actually checked (calibration, known dimension or documented export path)." },
    "scale_status": { "enum": ["UNKNOWN", "RELATIVE", "ESTIMATED", "VALIDATED"] },
    "scale_provenance": { "oneOf": [{ "$ref": "#/$defs/scale-provenance" }, { "type": "null" }] },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": { "type": "string", "description": "ISO 8601, UTC or explicit offset." },
    "scale-provenance": {
      "type": "object",
      "required": ["scale_status", "basis", "created_at"],
      "properties": {
        "scale_status": { "enum": ["UNKNOWN", "RELATIVE", "ESTIMATED", "VALIDATED"] },
        "basis": { "enum": ["none", "known_dimension", "survey_control", "validated_depth", "external_metric_scan", "operator_assumed", "other_documented"], "description": "Genuine evidence for the metric claim. A camera calibration alone is NOT a scale basis." },
        "detail": { "type": "string", "maxLength": 2000 },
        "measured_by": { "type": "string", "maxLength": 120 },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false,
      "description": "Rules: UNKNOWN pairs with basis 'none'; operator_assumed stays ESTIMATED at best; VALIDATED requires independent metric evidence (known_dimension, survey_control, validated_depth, external_metric_scan)."
    }
  }
}
