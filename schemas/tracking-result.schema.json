{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mining-scanner.local/schemas/tracking-result.schema.json",
  "title": "Tracking result and camera trajectory (v1.1)",
  "description": "Contracts for operations `visual_tracking` and `trajectory_generation` (registry stage 3, NOT_IMPLEMENTED). v1.1 (Stage 3 planning correction) separates the two: visual_tracking produces a frame-level TRK- tracking result; trajectory_generation derives an ordered TRJ- camera trajectory from a valid TRK-. Positions are in reconstruction units; monocular tracking is never metric by itself — scale_status + scale_provenance carry the real-world basis.",
  "type": "object",
  "required": ["tracking_result"],
  "properties": {
    "tracking_result": {
      "type": "object",
      "required": ["result_id", "project_id", "session_id", "method", "status", "calibration_id", "scale_status", "created_at"],
      "properties": {
        "result_id": { "type": "string", "pattern": "^TRK-[0-9a-f]{8}$" },
        "project_id": { "type": "string", "pattern": "^MS-[0-9a-f]{8}$" },
        "session_id": { "type": "string", "pattern": "^SES-[0-9a-f]{8}$" },
        "method": { "enum": ["orb_slam3_monocular", "colmap_feature_pipeline", "opencv_feature_trajectory", "other"] },
        "method_detail": { "type": "string", "maxLength": 200 },
        "status": { "enum": ["succeeded", "partial", "failed"] },
        "tracked_frame_count": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "total_frame_count": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "lost_frame_count": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }], "description": "Frames where tracking was lost; never silently dropped." },
        "calibration_id": { "type": "string", "pattern": "^CAL-[0-9a-f]{8}$" },
        "quality_note": { "type": "string", "maxLength": 1000, "description": "Relative-motion quality summary; never an accuracy claim." },
        "scale_status": { "enum": ["UNKNOWN", "RELATIVE"], "description": "Tracking output is at most RELATIVE scale — metric tracking scale requires fused evidence recorded downstream." },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "trajectory": {
      "type": "object",
      "required": ["trajectory_id", "project_id", "session_id", "source_tracking_result_id", "coordinate_frame", "timestamp_provenance", "poses", "scale_status", "created_at"],
      "properties": {
        "trajectory_id": { "type": "string", "pattern": "^TRJ-[0-9a-f]{8}$" },
        "project_id": { "type": "string", "pattern": "^MS-[0-9a-f]{8}$" },
        "session_id": { "type": "string", "pattern": "^SES-[0-9a-f]{8}$" },
        "source_tracking_result_id": { "type": "string", "pattern": "^TRK-[0-9a-f]{8}$" },
        "coordinate_frame": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Explicit frame, e.g. 'first_camera_frame' or 'arbitrary_world'." },
        "timestamp_provenance": { "enum": ["video_pts", "other_documented"], "description": "Where pose timestamps come from; video PTS by design, never reconstructed wall-clock exposure times." },
        "timestamp_provenance_detail": { "type": "string", "maxLength": 500 },
        "poses": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "required": ["pose_id", "inlier"],
            "properties": {
              "pose_id": { "type": "string", "pattern": "^POSE-[0-9a-f]{8}$" },
              "frame_id": { "oneOf": [{ "type": "string", "pattern": "^FRM-[0-9a-f]{8}$" }, { "type": "null" }] },
              "pts_ms": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
              "position": {
                "oneOf": [
                  { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"], "additionalProperties": false, "description": "In reconstruction units — metric meaning comes from scale_status." },
                  { "type": "null" }
                ]
              },
              "rotation": {
                "oneOf": [
                  { "type": "object", "properties": { "w": { "type": "number" }, "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["w", "x", "y", "z"], "additionalProperties": false, "description": "Unit quaternion (w, x, y, z)." },
                  { "type": "null" }
                ]
              },
              "inlier": { "type": "boolean", "description": "False = unreliable pose (tracking loss, low parallax); consumers must filter." }
            },
            "additionalProperties": false
          }
        },
        "scale_status": { "enum": ["UNKNOWN", "RELATIVE", "ESTIMATED", "VALIDATED"] },
        "scale_provenance": { "oneOf": [{ "$ref": "#/$defs/scale-provenance" }, { "type": "null" }] },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": { "type": "string", "description": "ISO 8601, UTC or explicit offset." },
    "scale-provenance": {
      "type": "object",
      "required": ["scale_status", "basis", "created_at"],
      "properties": {
        "scale_status": { "enum": ["UNKNOWN", "RELATIVE", "ESTIMATED", "VALIDATED"] },
        "basis": { "enum": ["none", "known_dimension", "survey_control", "validated_depth", "external_metric_scan", "operator_assumed", "other_documented"], "description": "Genuine evidence for the metric claim. A camera calibration alone is NOT a scale basis." },
        "detail": { "type": "string", "maxLength": 2000, "description": "What was measured and how. Required prose whenever basis is not 'none'." },
        "measured_by": { "type": "string", "maxLength": 120 },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false,
      "description": "Rules: UNKNOWN pairs with basis 'none'; operator_assumed stays ESTIMATED at best; VALIDATED requires independent metric evidence (known_dimension, survey_control, validated_depth, external_metric_scan)."
    }
  }
}
